        android:scaleX="0.0703125"
        android:scaleY="0.0703125">
        <!-- card2.svg: rotate(8 512 522) translate(30 -10), 22% -->
        <group android:rotation="8" android:pivotX="512" android:pivotY="522">
            <group android:translateX="30" android:translateY="-10">
                <path android:fillColor="#FFFFFF" android:fillAlpha="0.22" android:pathData="M326,212 H698 A64,64 0 0 1 762,276 V768 A64,64 0 0 1 698,832 H326 A64,64 0 0 1 262,768 V276 A64,64 0 0 1 326,212 Z" />
            </group>
        </group>
        <!-- card1.svg: rotate(-9 512 522) translate(-20 0), 40% -->
        <group android:rotation="-9" android:pivotX="512" android:pivotY="522">
            <group android:translateX="-20" android:translateY="0">
                <path android:fillColor="#FFFFFF" android:fillAlpha="0.4" android:pathData="M326,212 H698 A64,64 0 0 1 762,276 V768 A64,64 0 0 1 698,832 H326 A64,64 0 0 1 262,768 V276 A64,64 0 0 1 326,212 Z" />
