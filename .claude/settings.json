{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-before-commit.sh",
            "timeout": 1800,
            "statusMessage": "Checking the change before committing"
          }
        ]
      }
    ]
  },
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git -C * merge *)",
      "Bash(git checkout main*)",
      "Bash(git switch main*)",
      "Bash(website/deploy.sh*)",
      "Bash(*wrangler* pages deploy*)"
    ],
    "deny": [
      "Read(**/Secrets.xcconfig)",
      "Read(**/local.properties)",
      "Read(**/keystore.properties)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Edit(**/OpeningCoreRust/opening_core.swift)",
      "Edit(**/orbt/core/opening_core.kt)"
    ]
  }
}
